/*30. TASK 3 - TEMPERATURE CONVERSION
----------------------------------

Read a Celsius temperature and calculate Fahrenheit using:

	fahrenheit = celsius * 9.0 / 5.0 + 32.0

Test at least these values:

	0 Celsius    -> 32 Fahrenheit
	25 Celsius   -> 77 Fahrenheit
	100 Celsius  -> 212 Fahrenheit*/
import java.util.Scanner; 
public class Temp
{
    public static void main(String[] args) throws Exception
    {
        Scanner scan =new Scanner(System.in);
        System.out.print("enter temperaturein celsius ");
        int temp_celsius =scan.nextInt();
        double  temp_fahrenheit= (double)temp_celsius * 9.0 / 5.0 + 32.0;
        System.out.print("enter temperaturein celsius " +  temp_fahrenheit);

    }
}
